{
  "name": "@nexorajs/api",
  "version": "0.1.0",
  "description": "REST API with validation and error handling",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@nexorajs/auth": "workspace:*",
    "@nexorajs/database": "workspace:*",
    "@nexorajs/logger": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "homepage": "https://github.com/nexorajs/nexora#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexorajs/nexora.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/nexorajs/nexora/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "nexora",
    "discord",
    "bot",
    "typescript"
  ],
  "sideEffects": false
}
