{
  "name": "@nexora.ts/create",
  "version": "0.1.10",
  "description": "CLI to scaffold new Nexora Discord bot projects",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create": "./dist/index.js",
    "create-nexora-ts": "./dist/index.js",
    "nexora": "./dist/nexora.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/prompts": "^2.4.9",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "homepage": "https://github.com/ogcjay/nexorajs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogcjay/nexorajs.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/ogcjay/nexorajs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "nexora",
    "discord",
    "bot",
    "typescript"
  ]
}
