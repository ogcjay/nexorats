{
  "name": "@nexora.ts/database",
  "version": "0.1.1",
  "description": "Drizzle ORM database layer with repository pattern",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nexora.ts/config": "workspace:*",
    "drizzle-orm": "^0.38.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "postgres": "^3.4.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  },
  "peerDependencies": {
    "postgres": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "postgres": {
      "optional": true
    }
  },
  "homepage": "https://github.com/ogcjay/nexorajs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogcjay/nexorajs.git",
    "directory": "packages/database"
  },
  "bugs": {
    "url": "https://github.com/ogcjay/nexorajs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "nexora",
    "discord",
    "bot",
    "typescript"
  ],
  "sideEffects": false
}
